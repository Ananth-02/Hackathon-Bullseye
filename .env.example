# Copy to .env and fill in. .env is gitignored; never commit real keys.
# A real environment variable of the same name overrides the value here.
# Leave this file unused (or delete .env) to run fully offline.

# model 1
BULLSEYE_LLM_URL=https://api.deepseek.com
BULLSEYE_LLM_KEY=
BULLSEYE_LLM_MODEL=deepseek-v4-flash

# model 2: optional second opinion, disagreement lowers confidence
BULLSEYE_LLM2_URL=https://api.z.ai/api/paas/v4
BULLSEYE_LLM2_KEY=
BULLSEYE_LLM2_MODEL=glm-4.7-flash

# optional: extra request fields, e.g. switch off slow reasoning modes
BULLSEYE_LLM2_EXTRA={"thinking": {"type": "disabled"}}
